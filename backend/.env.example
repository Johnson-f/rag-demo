# Turso Database Configuration
# Get these values by running:
# turso db show --url <database-name>
# turso db tokens create <database-name>

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Optional: Custom paths
REPLICA_DB_PATH=local-replica.db
LOCAL_DB_PATH=local.db

# OpenRouter Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Embedding Model Configuration
# Available models: https://openrouter.ai/models?fmt=cards&output_modalities=embeddings
# Recommended models:
# - openai/text-embedding-3-small (default, 1536 dimensions, cost-effective)
# - openai/text-embedding-3-large (3072 dimensions, higher quality)
# - qwen/qwen3-embedding-0.6b (768 dimensions, fast and cheap)
# - qwen/qwen3-embedding-4b (1024 dimensions, balanced)
# - qwen/qwen3-embedding-8b (4096 dimensions, highest quality)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant Configuration
# For local: http://localhost:6333
# For cloud: https://your-cluster.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# Server Configuration
HOST=127.0.0.1
PORT=8080
